# Local frontend calls the Vite proxy; requests are forwarded to the deployed API by default.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=https://api.auto-catalog.app

# To use a local backend instead, set VITE_API_PROXY_TARGET=http://localhost:8000
# For Vercel, set VITE_API_URL=https://api.auto-catalog.app/api/v1 in project settings.
